# Configuration du serveur Supabase (valeurs publiques, visibles dans l'application : ce ne sont PAS des secrets).
# Supabase → Project Settings → API (ou « Connect ») :
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Ne mettez JAMAIS ici la clé « service_role » / « secret ».

# Google Agenda (facultatif) : « ID client » OAuth de type « Application Web » (public, ce n'est PAS un secret).
# Voir docs/GUIDE_GOOGLE_AGENDA.md. Ne mettez JAMAIS ici le « code secret du client ».
VITE_GOOGLE_CLIENT_ID=

# Notifications (facultatif) : clé PUBLIQUE générée dans Paramètres → Notifications → Mise en place.
# La clé PRIVÉE va uniquement dans les secrets Supabase (jamais ici). Voir docs/GUIDE_NOTIFICATIONS.md.
VITE_VAPID_PUBLIC_KEY=
